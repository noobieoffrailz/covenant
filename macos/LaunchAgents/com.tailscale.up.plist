<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Connect Tailscale after login (workaround: the app starts but stays
     disconnected, https://github.com/tailscale/tailscale/issues/21092) -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tailscale.up</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>sleep 15; /usr/local/bin/tailscale up</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/tailscale-up.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/tailscale-up.err</string>
</dict>
</plist>
