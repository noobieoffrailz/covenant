# Defaults for every machine. Machine files override only what differs.
# Unconfigured machine = grey + ban icon

set -gx GLOBAL_THEME_COLOR "#6e738d"
set -gx GLOBAL_PROMPT_ICON \uf05e # ban

set -gx BAT_THEME "Catppuccin Macchiato"
set -gx GHOSTTY_THEME "Catppuccin Macchiato"
set -gx EZA_THEME catppuccin/macchiato/catppuccin-macchiato-rosewater
set -gx LAZYGIT_THEME catppuccin/macchiato/rosewater
